# Cloudflare R2 credentials — copy this file to .env.local and fill it in.
#
# .env.local is gitignored and never leaves this machine. These values must
# NOT go anywhere near js/ — unlike the Web3Forms and Supabase anon keys,
# which are designed to be public, this secret can write and delete
# everything in the bucket.
#
# From Cloudflare: R2 > Manage R2 API Tokens > Create API Token
#   permission: Object Read & Write, scoped to your bucket

R2_ACCOUNT_ID=
R2_BUCKET=garrettphoto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
