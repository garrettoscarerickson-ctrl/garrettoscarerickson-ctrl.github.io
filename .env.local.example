# Local-only credentials. Copy to .env.local (gitignored) and fill in.
#
# NOTHING in this file may ever appear in js/ or be pasted into chat.
# Unlike the Supabase *anon* key and the Web3Forms key — both designed to
# be public and both already in the page — these bypass security entirely.
# They are read only by tools/ scripts running on this machine.

# --- Supabase (delivering files) ---
# Project Settings > API > service_role secret
SUPABASE_URL=https://wtvoftdnoptgxwbnzbzq.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=photos

# --- Cloudflare R2 (optional, only if you move off Supabase Storage) ---
# R2 > Manage R2 API Tokens > Create API Token (Object Read & Write)
R2_ACCOUNT_ID=
R2_BUCKET=garrettphoto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
